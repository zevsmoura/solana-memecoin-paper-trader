generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  email        String       @unique
  passwordHash String
  balance      BigInt       @default(10000000000)
  createdAt    DateTime     @default(now())
  holdings     Holding[]
  trades       Trade[]
}

model MarketToken {
  address       String            @id
  symbol        String
  name          String
  imageUrl      String?
  pairAddress   String
  dexId         String
  priceUsd      String
  priceChange1h Float             @default(0)
  priceChange6h Float             @default(0)
  priceChange24h Float            @default(0)
  buys24h       Int               @default(0)
  sells24h      Int               @default(0)
  liquidityUsd  Float             @default(0)
  volume24h     Float             @default(0)
  marketCap     String?
  pairCreatedAt DateTime?
  updatedAt     DateTime          @updatedAt
  snapshots     MarketSnapshot[]

  @@index([updatedAt])
  @@index([volume24h])
  @@index([liquidityUsd])
}

model MarketSnapshot {
  id             String      @id @default(cuid())
  tokenAddress   String
  minuteBucket   Int
  priceUsd       String
  priceChange24h Float       @default(0)
  liquidityUsd   Float       @default(0)
  volume24h      Float       @default(0)
  marketCap      String?
  capturedAt     DateTime    @default(now()) @updatedAt
  token          MarketToken @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  @@unique([tokenAddress, minuteBucket])
  @@index([tokenAddress, capturedAt])
  @@index([capturedAt])
}

model Holding {
  id            String   @id @default(cuid())
  userId        String
  tokenAddress  String
  symbol        String
  name          String
  quantity      String
  averageEntry  String
  realizedPnl   String   @default("0")
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, tokenAddress])
  @@index([userId])
}

model Trade {
  id           String   @id @default(cuid())
  userId       String
  tokenAddress String
  symbol       String
  side         String
  quantity     String
  priceUsd     String
  solAmount    BigInt
  feeLamports  BigInt
  realizedPnlUsd String  @default("0")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([createdAt])
}
